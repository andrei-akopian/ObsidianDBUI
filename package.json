{
  "name": "obsidian-db-ui",
  "version": "1.0.0",
  "description": "Minimalist, feature-rich database table UI for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/**/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "database",
    "table",
    "notion",
    "frontmatter"
  ],
  "author": "Andrei",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
